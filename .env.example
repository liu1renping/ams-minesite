# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/ams
# Atlas:  mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ams?retryWrites=true&w=majority
#
# Notes:
# - No spaces in the URI
# - URL-encode special characters in the password (@ # / etc.)
# - Ensure Atlas Network Access allows your IP (or 0.0.0.0/0 for dev)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ams?retryWrites=true&w=majority
